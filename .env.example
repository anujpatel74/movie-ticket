# ========================================================
# CINEMA BOOKING - Environment Variables Template
# Copy this file to .env for local overrides, or configure
# these variables directly in Railway / your cloud dashboard.
# NEVER commit the real .env file with production secrets!
# ========================================================

# --------------------------------------------------------
# 1. DATABASE CONFIGURATION (Railway / Cloud MySQL)
# Railway MySQL provisioner injects these automatically:
# --------------------------------------------------------
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLDATABASE=cinema_booking
MYSQLUSER=root
MYSQLPASSWORD=

# Alternative standard database variables (used if MYSQL* is not defined):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cinema_booking
DB_USER=root
DB_PASS=

# --------------------------------------------------------
# 2. TMDB API CREDENTIALS (Movie Discovery & Details)
# Get a free API key at: https://www.themoviedb.org/settings/api
# --------------------------------------------------------
TMDB_API_KEY=
TMDB_READ_TOKEN=

# --------------------------------------------------------
# 3. APPLICATION PORT (Railway injects PORT automatically)
# --------------------------------------------------------
PORT=80

